const entradas = [2000, 250];
let i = 0

function gets() {
  const valor = entradas[i];
  i++;
  return valor;
}

function print(texto) {
  console.log(texto);
}

let salariobruto = gets();
let adicional = gets();

function calcularimposto(valor,percentual){
    return valor * (percentual / 100)
}

function percentualcombasenosalario(salario) {
    if (salario >= 0 && salario <= 1100.00) {
        return 5;
    } else if (salario >= 1100.01 && salario <= 2500) {
        return 10;
    } else {
        return 15;
    }
}

const imposto = percentualcombasenosalario(salariobruto);
const valorimposto = calcularimposto(salariobruto, imposto);
const valoratransferir= salariobruto - valorimposto + adicional
print(valoratransferir)
